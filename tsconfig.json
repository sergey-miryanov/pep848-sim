// tsc checks the site's JavaScript, its tests and the dev pages' in tools/ from
// their JSDoc and emits nothing: the page's scripts, the tests and the dev
// pages' here, against the DOM, and the worker in tsconfig.worker.json. It leaves the packages' declarations
// unchecked: pyodide's name Node's types, which the project takes no package for.
{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom"]
  },
  "include": ["site/**/*.js", "tests/**/*.js", "tools/**/*.js"],
  "exclude": ["site/worker.js"]
}
